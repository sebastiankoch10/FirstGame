st","title":"Gegner - Bewegungsidentitaeten in den Aschenfrost-Ruinen","category":"Gegner","content":"Eisgeist schwebt und steigt vor dem Angriff, Konstrukt und Ruestung stampfen schwer, Aschenkrieger stoesst vor","goal":"Unterschiedliche Rhythmen und Gewicht, lesbare Angriffsvorbereitung.","task":"Phase 2B","scenario":{"type":"scene","class":"Mage","minute":10,"arena":2,"build":"balanced","invulnerable":true},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"spell.spikes.phases","title":"Faehigkeit - Steinstacheln: Sammelphase und Einschlagslicht (Stufe 5)","category":"Faehigkeiten: Progression","content":"Energie sammelt sich am naechsten Einschlagspunkt, Licht beim Schadensereignis nach Stufe; Dauer, Zeitpunkt und Trefferflaeche unveraendert","goal":"Ankuendigung am richtigen Ort lesbar, Einschlag mit Gewicht, kein Bildschirmflackern.","task":"Folgeauftrag 26.11.","scenario":{"type":"scene","class":"Mage","minute":10,"arena":1,"build":"empty","spells":[{"id":110,"level":5}],"invulnerable":true,"enemy_pack":{"count":8,"radius":260}},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"spell.starfall.phases","title":"Faehigkeit - Sternenfall: Sammelphase und Einschlagslicht (Stufe 5)","category":"Faehigkeiten: Progression","content":"Sternsplitter sammeln Energie am kommenden Einschlag, Licht beim Treffer nach Stufe; Timing unveraendert","goal":"Reihenfolge der Einschlaege erkennbar, Licht dezent statt grell.","task":"Folgeauftrag 26.11.","scenario":{"type":"scene","class":"Mage","minute":10,"arena":1,"build":"empty","spells":[{"id":113,"level":5}],"invulnerable":true,"enemy_pack":{"count":8,"radius":260}},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"spell.seed.phases","title":"Faehigkeit - Prismensamen: Einschlagslicht (Stufe 5)","category":"Faehigkeiten: Progression","content":"Reisender Kern zerbricht mit Lichtimpuls nach Stufe; Timing unveraendert","goal":"Zerbrechen als klarer Hoehepunkt, Licht passt zur Stufe.","task":"Folgeauftrag 26.11.","scenario":{"type":"scene","class":"Mage","minute":10,"arena":1,"build":"empty","spells":[{"id":117,"level":5}],"invulnerable":true,"enemy_pack":{"count":8,"radius":260}},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"enemy.motion.forest","title":"Gegner - Bewegungsidentitaeten der Wald-Skelette","category":"Gegner","content":"Krieger steif-ruckig, Spaeher schnell und vorgebeugt, Wache schwer; Ausholen und Vorstoss beim Schlag, Klappern bei Treffern, Laufrate je Rolle","goal":"Die drei Rollen sind an der Bewegung unterscheidbar, ohne zu zappeln.","task":"Folgeauftrag 26.11.","scenario":{"type":"scene","class":"Sword","minute":10,"arena":0,"build":"balanced","invulnerable":true},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"ui.font.magnet","title":"UI - Pixelschrift MAGNET beim Einsammeln der Magnetkugel","category":"UI","content":"Welt-Pixelschrift mit Buchstaben (5x7), MAGNET auf ganzen Pixeln","goal":"In die Kugel laufen: Schrift scharf, lesbar, im Stil der Schadenszahlen.","task":"Folgeauftrag 26.11.","scenario":{"type":"scene","class":"Ranger","minute":10,"arena":0,"build":"balanced","invulnerable":true,"magnet_orb":true},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"char.armor.hidden","title":"Charakter - Ruestung unsichtbar, nur die Waffe sichtbar (Schwertmeister)","category":"Charakter","content":"Schwertmeister mit voller Ausruestung der Stufe 3 (Helm, Brust, Haende, Fuesse, Waffe) und Alternativen im Rucksack. Ruestung wirkt nur ueber Werte, an der Figur ist nur die Waffe zu sehen. Gilt fuer alle Klassen.","goal":"Druecke T und wechsle Helm, Brust, Haende und Fuesse: die Figur bleibt gleich, kein Helm, keine Reste. Wechsle die Waffe: sie aendert sich sofort an der Figur. Laufe in alle Richtungen, springe und greife an.","task":"Nutzerentscheidung 26.11. abends","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"showroom","class":"Sword","minute":10,"arena":0,"gear":3,"backpack":[{"slot":"head","rarity":2},{"slot":"chest","rarity":1},{"slot":"hands","rarity":2},{"slot":"feet","rarity":1},{"slot":"weapon","rarity":2}],"invulnerable":true}},{"id":"char.attach.anchors","title":"Charakter - Waffen-Ankerpunkte (F10-Anzeige)","category":"Charakter","content":"Griffpunkt und Waffenrichtung je Animationsbild (eqv_attach); F10 zeigt Griff (tuerkis, orange bei verdeckter Hand) und Richtung","goal":"Mit F10 bewegen und angreifen: der Griff sitzt in der Hand, die Richtung folgt der Waffe.","task":"Folgeauftrag 26.11.","scenario":{"type":"scene","class":"Sword","minute":10,"arena":0,"build":"balanced","gear":2,"invulnerable":true},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"combat.hitstop","title":"Combat Feeling - Trefferstopp bei physischen Treffern","category":"Klassen: Grundangriffe","content":"Gegnerbild friert bei Treffern der Grundwaffe (Schwert, Pfeile) 2 Bilder ein und zittert 1 Pixel; Spielersteuerung, Takt und Schaden unveraendert","goal":"Treffer fuehlen sich wuchtiger an, ohne dass etwas haengt.","task":"Folgeauftrag 26.11.","scenario":{"type":"scene","class":"Sword","minute":10,"arena":0,"build":"balanced","invulnerable":true,"enemy_pack":{"count":8,"radius":160}},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"boss.dragon.seq_p1","title":"Drache - Sequenz Feuerschneise (Phase 1: Feueratem, Faecher)","category":"Bosse: Drache","content":"Choreografierte Sequenz aus vorhandenen Faehigkeiten, faire Pause zwischen den Schritten, Ruhe danach; wiederholt sich im Review","goal":"Reihenfolge lernbar, Ueberlebensweg immer erkennbar, kein Schritt bricht ab.","task":"Folgeauftrag 26.11.","scenario":{"type":"boss","boss":"storm_warden","minute":15,"class":"Mage","ability":-1,"seed":1337,"build":"balanced","gear":2,"boss_hp":0.95,"sequence":0},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"boss.dragon.seq_p3","title":"Drache - Sequenz Feuersturm (Phase 3: Feueratem, Magma-Schachbrett, kontrahierende Ringe)","category":"Bosse: Drache","content":"Feueratem, dann Schachbrett und invertiertes Brett, dann Feuerringe von aussen nach innen; Pausen zwischen den Schritten","goal":"Lesbar, fair und lernbar; jeder Schritt hat einen klaren sicheren Weg.","task":"Folgeauftrag 26.11.","scenario":{"type":"boss","boss":"storm_warden","minute":15,"class":"Mage","ability":-1,"seed":1337,"build":"balanced","gear":2,"boss_hp":0.45,"sequence":0},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"boss.twins.motion","title":"Zwillingshexen - Aufladen und Einschlag (Bewegungsidentitaet)","category":"Bosse: Zwillingshexen","content":"Beim Aufladen ziehen sich die Hexen zurueck und steigen leicht, beim Ausloesen stossen sie vor; nur Darstellung","goal":"Ankuendigung am Koerper lesbar, Bewegung ganzpixelig ohne Zittern.","task":"Folgeauftrag 26.11.","scenario":{"type":"boss","boss":"twins","minute":15,"class":"Mage","ability":-1,"seed":1337,"build":"balanced","gear":2},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"boss.behemoth.motion","title":"Sumpfbehemoth - Aufladen und Einschlag (Bewegungsidentitaet)","category":"Bossverhalten","content":"Beim Aufladen duckt sich der Behemoth zurueck, beim Einschlag stoesst er schwer vor; nur Darstellung","goal":"Gewicht spuerbar, Ankuendigung am Koerper lesbar.","task":"Folgeauftrag 26.11.","scenario":{"type":"boss","boss":"behemoth","minute":15,"class":"Mage","ability":-1,"seed":1337,"build":"balanced","gear":2},"revision":1,"status":"pending","created":"2026-11-26","approved_at":null},{"id":"vfx.overhaul.dragon_breath","title":"Grafik-Overhaul - Drachen-Feueratem im Wald (Licht, Glut, Hitzeflimmern)","category":"VFX","content":"Schaustueck mit neu gestalteter Gefahrenflaeche: Aufladen mit einstroemender Glut und Aura, Zuendung mit Druckwelle und warmem Farbumschlag; Strahl mit zuengelnden Flammen, weissgluehendem Kern, hellem Innenrand und dunkler Kontur genau an der Trefferbreite, Funken im Strahl, Hitzeflimmern, Lichtbahn auf dem Boden, Rauch und Brandspuren","goal":"Massstab Octopath Traveler: Wirkt der Feueratem wie echtes Feuer im Raum? Leuchten Boden, Baeume und Figur im Feuerlicht? Ist die Trefferbreite (Rand) mindestens so klar wie vorher?","task":"Grafik-Overhaul 26.11. (Schaustueck)","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"boss","boss":"storm_warden","minute":15,"class":"Sword","ability":1,"seed":1337,"build":"balanced","gear":2,"arena":0}},{"id":"vfx.overhaul.sword_fireball","title":"Grafik-Overhaul - Feuerball (Schwertmeister, Stufe 9)","category":"VFX","content":"Feuerball mit Glutspur und Rauch, Einschlag mit weissem Kern, Funkenstrahlen, Druckwelle, Rauch, Brandmal und Licht auf Boden und Gegnern","goal":"Ist der Einschlag wuchtig und lebendig (viele Pixel, Aufblitzen, Druckwelle), ohne die Figur zu verdecken?","task":"Grafik-Overhaul 26.11. (Schaustueck)","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"scene","class":"Sword","minute":10,"arena":0,"build":"empty","spells":[{"id":101,"level":9}],"spells_replace":true,"enemies":"normal","enemy_pack":{"count":14,"radius":250},"invulnerable":true,"gear":2}},{"id":"vfx.overhaul.mage_lightning","title":"Grafik-Overhaul - Kettenblitz (Arkanistin, Stufe 9)","category":"VFX","content":"Kettenblitz mit Glimmen, Funkenlinien je Sprung, Einschlag mit Kern, Druckwelle, Farbversatz im Endgame und blauem Licht auf dem Boden","goal":"Knistert der Blitz sichtbar, leuchtet er die Umgebung aus, und bleibt er trotzdem kurz und lesbar?","task":"Grafik-Overhaul 26.11. (Schaustueck)","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"scene","class":"Mage","minute":10,"arena":0,"build":"empty","spells":[{"id":103,"level":9}],"spells_replace":true,"enemies":"normal","enemy_pack":{"count":14,"radius":250},"invulnerable":true,"gear":2}},{"id":"vfx.overhaul.ranger_ice","title":"Grafik-Overhaul - Eisball (Waldlaeufer, Stufe 9)","category":"VFX","content":"Eisball mit Frostglitzer, Einschlag mit Glassplittern, Frostnebel, Raureif am Boden und kaltem Licht","goal":"Splittert das Eis wie Glas (Referenz Dagger Dance), ohne zu ueberladen?","task":"Grafik-Overhaul 26.11. (Schaustueck)","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"scene","class":"Ranger","minute":10,"arena":0,"build":"empty","spells":[{"id":102,"level":9}],"spells_replace":true,"enemies":"normal","enemy_pack":{"count":14,"radius":250},"invulnerable":true,"gear":2}},{"id":"char.overhaul.sword","title":"Grafik-Overhaul - Figur im Licht: Schwertmeister im Wald","category":"Charakter","content":"Randlicht in der Farbe der staerksten Lichtquelle, weicher Bodenschatten, der vom Feuer weg faellt, Staub beim Laufen, Springen, Landen und bei der Ausweichrolle, Funken bei der Rolle, Gluehen und Lichtfunkeln an der Klinge, weisses Trefferaufblitzen, Aura beim Wirbelangriff","goal":"Laufe zu Fackeln und Gegnern, springe (Leertaste) und rolle (Strg): Wirkt die Figur wie im Licht stehend (Massstab Octopath)? Bleibt sie gut lesbar?","task":"Grafik-Overhaul 26.11. (Schaustueck)","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"scene","class":"Sword","minute":10,"arena":0,"build":"balanced","gear":2,"enemies":"normal","enemy_pack":{"count":10,"radius":260}}},{"id":"light.overhaul.forest","title":"Grafik-Overhaul - Licht und Atmosphaere: Wald","category":"Licht","content":"Verstaerkbares Weltlicht, Lichtstrahlen von oben links mit Lichtfleck, Staub und Pollen, die im Licht aufleuchten, Gluehwuermchen, Farbgebung, Tiefenunschaerfe am oberen und unteren Rand, Vignette, Gluehen heller Kerne","goal":"Laufe herum: Wirkt der Wald tief und atmosphaerisch (Massstab Octopath)? Ist nichts zu dunkel oder zu unscharf?","task":"Grafik-Overhaul 26.11. (Schaustueck)","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"showroom","class":"Sword","minute":5,"arena":0,"gear":1,"invulnerable":true}},{"id":"light.overhaul.swamp","title":"Grafik-Overhaul - Licht und Atmosphaere: Sumpf","category":"Licht","content":"Sumpf mit gruenlicher Farbgebung, Sporen, Gluehwuermchen, schwachen Lichtstrahlen, Tiefenunschaerfe und Vignette","goal":"Laufe herum: Passt die Stimmung zum Sumpf? Ist nichts zu dunkel?","task":"Grafik-Overhaul 26.11. (Schaustueck)","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"showroom","class":"Mage","minute":5,"arena":1,"gear":1,"invulnerable":true}},{"id":"light.overhaul.ashfrost","title":"Grafik-Overhaul - Licht und Atmosphaere: Aschenfrost-Ruinen","category":"Licht","content":"Kalte Farbgebung, Asche und Schnee im Wind, aufsteigende Glut, kalte Lichtstrahlen, Tiefenunschaerfe und Vignette","goal":"Laufe herum: Wirken die Ruinen kalt und verbrannt zugleich? Ist nichts zu dunkel?","task":"Grafik-Overhaul 26.11. (Schaustueck)","revision":1,"status":"pending","created":"2026-11-26","approved_at":null,"scenario":{"type":"showroom","class":"Ranger","minute":5,"arena":2,"gear":1,"invulnerable":true}}]');
